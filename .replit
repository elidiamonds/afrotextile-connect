modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_EMAIL = "ellprimegroup@gmail.com"
VITE_ADMIN_EMAIL = "ellprimegroup@gmail.com"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 80

[[ports]]
localPort = 19061
externalPort = 3001

[[ports]]
localPort = 19373
externalPort = 3002

[[ports]]
localPort = 20814
externalPort = 3003

[[ports]]
localPort = 23716
externalPort = 4200

[[ports]]
localPort = 23717
externalPort = 3000
